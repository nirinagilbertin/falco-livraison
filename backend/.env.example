# --- Serveur ---
NODE_ENV=development
PORT=3000

# --- Base de données (XAMPP : MySQL/MariaDB local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=falco_livraison

# --- Sécurité ---
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=30m
BCRYPT_ROUNDS=10

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:4200
